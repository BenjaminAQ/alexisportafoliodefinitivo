rules_version = '2';

// ============================================================
// REGLAS DE SEGURIDAD FIRESTORE — Portafolio de Alexis
// ============================================================
// Colecciones:
//   - users/{uid}     : { uid, email, displayName, role, createdAt }
//                       role = "admin" | "usuario" | "pending"
//   - sections/{id}   : contenido de cada sección (home, about, projects, ...)
//
// Política de acceso:
//   - sections: LECTURA PÚBLICA para todos (incluyendo anónimos) —
//                esto permite que cualquier visitante vea el contenido
//                EN TIEMPO REAL vía onSnapshot. ESCRITURA solo admins.
//   - users:    Lectura solo autenticada (para verificar roles).
//               Creación automática de doc "pending" en primer login.
//               Modificación solo por admins (promover/desgraduar).
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: ¿el usuario actual es admin?
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Colección users ----
    match /users/{uid} {
      // Cualquier usuario autenticado puede leer (para verificar roles)
      allow read: if request.auth != null;

      // Un usuario puede CREAR su propio doc en el primer login (role = "pending")
      // Esto permite el flujo de auto-registro.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.role == 'pending'
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;

      // Solo los admins pueden actualizar o eliminar docs de usuarios
      // (cambiar roles de pending a admin, etc.)
      allow update, delete: if isAdmin();
    }

    // ---- Colección sections (contenido de la web) ----
    // LECTURA PÚBLICA: cualquiera (incluyendo anónimos) puede leer.
    // Esto es CRÍTICO para que todos los visitantes vean los cambios
    // del admin EN TIEMPO REAL a través de onSnapshot listeners.
    // ESCRITURA: solo administradores.
    match /sections/{sectionId} {
      allow read: if true;            // lectura pública — tiempo real para todos
      allow write: if isAdmin();       // solo admins pueden editar
    }

    // Negar todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
