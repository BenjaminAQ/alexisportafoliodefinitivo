rules_version = '2';

// ============================================================
// REGLAS DE SEGURIDAD FIREBASE STORAGE — Portafolio de Alexis
// ============================================================
// Estructura:
//   - images/{uid}/{timestamp}-{filename}   : imágenes de perfil/secciones
//   - files/{uid}/{timestamp}-{filename}    : PDFs, documentos, código, etc.
//
// Política de acceso:
//   - LECTURA PÚBLICA: cualquiera (incluyendo anónimos) puede leer.
//     Esto permite que TODOS los visitantes vean las imágenes y
//     descarguen/previsualicen archivos en la web.
//   - ESCRITURA: solo administradores (verifica rol en Firestore).
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: ¿el usuario actual es admin en Firestore?
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- Imágenes (perfil + secciones) ----
    match /images/{uid}/{fileName} {
      allow read: if true;            // lectura pública — todos ven las imágenes
      allow write: if isAdmin();      // solo admins suben/eliminan
    }

    // ---- Archivos (PDFs, documentos, código) ----
    match /files/{uid}/{fileName} {
      allow read: if true;            // lectura pública — todos ven/descargan archivos
      allow write: if isAdmin();      // solo admins suben/eliminan
    }

    // ---- Carpeta uploads (legacy/fallback) ----
    match /uploads/{uid}/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Negar todo lo demás por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
